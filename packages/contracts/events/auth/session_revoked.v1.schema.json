{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/auth/session_revoked.v1.schema.json",
  "title": "auth.session_revoked v1",
  "description": "A session was revoked. No token material.",
  "type": "object",
  "required": ["user_id", "session_id", "reason_code", "revoked_at"],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "x-clinic": {
    "owning_module": "Auth",
    "classification": "internal",
    "consumers": ["auth.realtime_disconnect"],
    "retention_days": 90
  }
}
