{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/auth/credential_version_changed.v1.schema.json",
  "title": "auth.credential_version_changed v1",
  "description": "Password or recovery rotated the credential version. No secret.",
  "type": "object",
  "required": ["user_id", "credential_version", "reason_code"],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "credential_version": {
      "type": "integer",
      "minimum": 1
    },
    "reason_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  },
  "x-clinic": {
    "owning_module": "Auth",
    "classification": "internal",
    "consumers": ["auth.session_invalidation"],
    "retention_days": 365
  }
}
