{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/doctor/profile_created.v1.schema.json",
  "title": "doctor.profile_created v1",
  "description": "A doctor profile was created. No National ID, syndicate number, display name, ciphertext, HMAC, or key versions.",
  "type": "object",
  "required": ["doctor_id", "linked_user_id", "source_type"],
  "additionalProperties": false,
  "properties": {
    "doctor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "linked_user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_type": {
      "type": "string",
            "enum": ["self_onboarding", "admin_created"]
    }
  },
  "x-clinic": {
    "owning_module": "Doctors",
    "classification": "personal",
    "consumers": ["audit.identity"],
    "retention_days": 365
  }
}
