{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/identity/account_registered.v1.schema.json",
  "title": "identity.account_registered v1",
  "description": "A pending user row was created. No phone, National ID, or credential is included.",
  "type": "object",
  "required": ["user_id", "status", "locale"],
  "additionalProperties": false,
  "properties": {
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": ["pending_phone", "active", "suspended", "locked", "closed"]
    },
    "locale": {
      "type": "string",
      "enum": ["ar", "en"]
    }
  },
  "x-clinic": {
    "owning_module": "Identity",
    "classification": "personal",
    "consumers": ["audit.identity"],
    "retention_days": 365
  }
}
