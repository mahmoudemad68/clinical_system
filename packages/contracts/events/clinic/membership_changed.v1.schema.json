{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/clinic/membership_changed.v1.schema.json",
  "title": "clinic.membership_changed v1",
  "description": "A clinic staff membership changed. No phone, HMAC, invitation target, invitation secret, staff identity details, or clinical data. scope_type is bounded to clinic_location for this slice.",
  "type": "object",
  "required": ["membership_id", "scope_type", "scope_id", "status"],
  "additionalProperties": false,
  "properties": {
    "membership_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope_type": {
      "type": "string",
      "enum": ["clinic_location"]
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "suspended", "revoked"]
    }
  },
  "x-clinic": {
    "owning_module": "Clinics",
    "classification": "personal",
    "consumers": ["audit.identity"],
    "retention_days": 365
  }
}
