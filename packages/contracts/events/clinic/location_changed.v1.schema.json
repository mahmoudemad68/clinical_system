{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/clinic/location_changed.v1.schema.json",
  "title": "clinic.location_changed v1",
  "description": "A clinic location was created, updated, or closed. No address, coordinates, ciphertext, HMAC, or key versions.",
  "type": "object",
  "required": ["location_id", "doctor_id", "version", "change_type"],
  "additionalProperties": false,
  "properties": {
    "location_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "doctor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change_type": {
      "type": "string",
      "enum": ["created", "updated", "closed"]
    }
  },
  "x-clinic": {
    "owning_module": "Clinics",
    "classification": "personal",
    "consumers": ["audit.identity"],
    "retention_days": 365
  }
}
