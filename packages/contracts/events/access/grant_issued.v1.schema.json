{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/access/grant_issued.v1.schema.json",
  "title": "access.grant_issued v1",
  "description": "A contextual access grant was issued. No secret material.",
  "type": "object",
  "required": ["grant_id", "subject_user_id", "capability", "resource_type", "resource_id", "context_type", "context_id", "reason_code", "issued_at"],
  "additionalProperties": false,
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "subject_user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capability": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_.]{0,79}$"
    },
    "resource_type": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "context_type": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "x-clinic": {
    "owning_module": "Access",
    "classification": "internal",
    "consumers": ["audit.access"],
    "retention_days": 365
  }
}
