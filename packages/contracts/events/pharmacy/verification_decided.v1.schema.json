{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/pharmacy/verification_decided.v1.schema.json",
  "title": "pharmacy.verification_decided v1",
  "description": "A pharmacy verification case was decided. No legal registration, legal name, address, phone, coordinates, documents, object identifiers, reviewer notes, HMAC, ciphertext, key versions, or scanner payloads.",
  "type": "object",
  "required": ["organization_id", "branch_ids", "case_id", "decision", "reason_code"],
  "additionalProperties": false,
  "properties": {
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "branch_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected", "changes_requested"]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+$"
    }
  },
  "x-clinic": {
    "owning_module": "Verification",
    "classification": "internal",
    "consumers": ["audit.identity"],
    "retention_days": 365
  }
}
