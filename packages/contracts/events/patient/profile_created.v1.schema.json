{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.clinic.invalid/events/patient/profile_created.v1.schema.json",
  "title": "patient.profile_created v1",
  "description": "A patient demographic profile was created. No National ID, name, DOB, or ciphertext.",
  "type": "object",
  "required": ["patient_id", "linked_user_id", "source_type"],
  "additionalProperties": false,
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "linked_user_id": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      ]
    },
    "source_type": {
      "type": "string",
      "enum": ["self_onboarding", "walk_in"]
    }
  },
  "x-clinic": {
    "owning_module": "Patients",
    "classification": "personal",
    "consumers": ["audit.identity"],
    "retention_days": 365
  }
}
