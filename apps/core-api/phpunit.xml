<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="01234567890123456789012345678901"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="ARGON_MEMORY" value="16384"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="IDENTITY_ALLOW_SYNTHETIC_NATIONAL_IDS" value="true"/>
        <env name="IDENTITY_HMAC_KEY_V1" value="test_identity_hmac_v1_not_a_secret_value!!"/>
        <env name="IDENTITY_ENCRYPTION_KEY_V1" value="test_identity_enc_v1_not_a_secret_value!!"/>
        <env name="AUTH_OTP_PEPPER_V1" value="test_otp_pepper_v1_not_a_secret_value!!!!"/>
        <env name="FEATURE_AUTH_REGISTRATION" value="true"/>
        <env name="FEATURE_IDENTITY_PROFILE_CLAIM" value="false"/>
        <env name="FEATURE_AUTH_RECOVERY" value="true"/>
        <env name="IDENTITY_BOOTSTRAP_ENABLED" value="true"/>
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="REVERB_APP_ID" value="clinic-test"/>
        <env name="REVERB_APP_KEY" value="local_dev_only_not_a_secret"/>
        <env name="REVERB_APP_SECRET" value="local_dev_only_not_a_secret"/>
        <env name="REVERB_HOST" value="127.0.0.1"/>
        <env name="REVERB_PORT" value="8081"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="AUTH_RATE_LIMIT_STORE" value="ratelimit"/>
        <env name="AUTH_RATE_LIMIT_DRIVER" value="array"/>
        <env name="AUTH_OTP_VERIFY_PER_IP_PER_MINUTE" value="100000"/>
        <env name="AUTH_OTP_VERIFY_PER_CHALLENGE_PER_MINUTE" value="100000"/>
        <env name="AUTH_RECOVERY_PER_IP_PER_HOUR" value="100000"/>
        <env name="IDENTITY_RECOVERY_COOLING_OFF_SECONDS" value="0"/>
        <env name="IDENTITY_HMAC_KEY_V2" value="test_identity_hmac_v2_not_a_secret_value!!"/>
        <env name="IDENTITY_ENCRYPTION_KEY_V2" value="test_identity_enc_v2_not_a_secret_value!!"/>
        <!--
            Feature tests run against real PostgreSQL, not SQLite.

            The migrations use jsonb, partial indexes, and regex CHECK
            constraints that SQLite cannot express, and those constraints are a
            material part of what the tests assert. An in-memory SQLite suite
            would pass while proving nothing about the schema that actually
            ships.

            Values are overridable so CI and the local container can point at
            their own instance.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="clinic_test"/>
        <env name="DB_USERNAME" value="clinic_migrator"/>
        <env name="DB_PASSWORD" value="local_dev_only_not_a_secret"/>
        <env name="DB_MIGRATION_USERNAME" value="clinic_migrator"/>
        <env name="DB_MIGRATION_PASSWORD" value="local_dev_only_not_a_secret"/>
        <env name="DB_AUDIT_USERNAME" value="clinic_audit_writer"/>
        <env name="DB_AUDIT_PASSWORD" value="local_dev_only_not_a_secret"/>
        <env name="DB_WORKER_USERNAME" value="clinic_worker" force="true"/>
        <env name="DB_WORKER_PASSWORD" value="local_dev_only_not_a_secret" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="APP_VERSION" value="0.0.0-test"/>
        <env name="APP_BUSINESS_TIMEZONE" value="Africa/Cairo"/>
        <env name="APP_SUPPORTED_LOCALES" value="ar,en"/>
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="AI_SERVICE_BASE_URL" value=""/>
        <env name="TELEMETRY_REDACTION_STRICT" value="true"/>
        <env name="PENNANT_STORE" value="array"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:5173"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SESSION_COOKIE" value="clinic_session"/>
        <env name="SESSION_SAME_SITE" value="lax"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="FIREBASE_CREDENTIALS" value=""/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
