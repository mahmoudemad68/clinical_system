# Copied from infra/environments/local.env for `composer setup` / artisan on the host.
#
# LOCAL VALUES ONLY. Every secret-shaped value is a well-known development
# placeholder. Real credentials live in an approved secret manager.
#
# When running inside Compose, use DB_HOST=postgres and REDIS_HOST=redis
# (see infra/environments/local.env). Host-side defaults below target the
# published 127.0.0.1 ports.

APP_NAME="Clinic Platform"
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
APP_URL=http://localhost:8080
APP_VERSION=0.1.0-local
BUILD_COMMIT=local
BUILD_TIMESTAMP=1970-01-01T00:00:00Z

APP_COUNTRY=EG
APP_CURRENCY=EGP
APP_BUSINESS_TIMEZONE=Africa/Cairo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=ar,en
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clinic
DB_USERNAME=clinic_app
DB_PASSWORD=local_dev_only_not_a_secret
DB_SSLMODE=prefer
# Production must set require, verify-ca, or verify-full plus DB_SSLROOTCERT / PGSSLROOTCERT.
# See docs/operations/production-kms-tls.md.
# DB_SSLROOTCERT=
# DB_SSLCERT=
# DB_SSLKEY=

DB_MIGRATION_USERNAME=clinic_migrator
DB_MIGRATION_PASSWORD=local_dev_only_not_a_secret

DB_WORKER_USERNAME=clinic_worker
DB_WORKER_PASSWORD=local_dev_only_not_a_secret
DB_REPORTER_USERNAME=clinic_reporter
DB_REPORTER_PASSWORD=local_dev_only_not_a_secret
DB_AUDIT_USERNAME=clinic_audit_writer
DB_AUDIT_PASSWORD=local_dev_only_not_a_secret

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_REALTIME_DB=2
REDIS_RATELIMIT_DB=3

CACHE_STORE=redis
CACHE_PREFIX=clinic_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
QUEUE_CONNECTION_REDIS=queue

OCTANE_SERVER=frankenphp
OCTANE_MAX_REQUESTS=500

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=clinic-local
REVERB_APP_KEY=local_dev_only_not_a_secret
REVERB_APP_SECRET=local_dev_only_not_a_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=clinic_local
AWS_SECRET_ACCESS_KEY=local_dev_only_not_a_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clinic-local-private
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=local_dev_only_not_a_secret
AI_SERVICE_TIMEOUT_MS=2000
AI_SERVICE_REQUIRED_FOR_READINESS=false

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=local_dev_only_not_a_secret

TELEMETRY_REDACTION_ENABLED=true
TELEMETRY_REDACTION_STRICT=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

PENNANT_STORE=database

FEATURE_PLATFORM_DIAGNOSTICS_SLICE=true
FEATURE_AUTH_REGISTRATION=true
FEATURE_IDENTITY_PROFILE_CLAIM=false
FEATURE_AUTH_RECOVERY=false
FEATURE_ONLINE_PAYMENTS=false
FEATURE_EMERGENCY_CHAT=false
FEATURE_DRUG_ALTERNATIVES=false
FEATURE_BRANCH_TRANSFERS=false
FEATURE_PATIENT_ADHERENCE=false
FEATURE_MEDICAL_IMAGING_AI=false
FEATURE_SUPPLIER_API_INTEGRATION=false
FEATURE_MULTI_COUNTRY=false

REQUEST_MAX_BODY_BYTES=1048576
REQUEST_MAX_JSON_DEPTH=32
IDEMPOTENCY_RETENTION_HOURS=72
OUTBOX_CLAIM_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

IDENTITY_ALLOW_SYNTHETIC_NATIONAL_IDS=true
IDENTITY_HMAC_VERSION=1
IDENTITY_HMAC_KEY_V1=local_dev_only_identity_hmac_v1_not_a_secret_32b
IDENTITY_HMAC_KEY_V2=
IDENTITY_ENCRYPTION_VERSION=1
IDENTITY_ENCRYPTION_KEY_V1=local_dev_only_identity_enc_v1_not_a_secret_32b
IDENTITY_ENCRYPTION_KEY_V2=
AUTH_OTP_PEPPER_VERSION=1
AUTH_OTP_PEPPER_V1=local_dev_only_otp_pepper_v1_not_a_secret_32bytes
IDENTITY_BOOTSTRAP_ENABLED=true
AUTH_RATE_LIMIT_STORE=ratelimit
AUTH_RATE_LIMIT_DRIVER=redis
# Production must set this to the reverse-proxy hop list. Empty is fail-closed
# for production readiness; local traffic is direct.
TRUSTED_PROXIES=

TELESCOPE_ENABLED=false

FIREBASE_CREDENTIALS=
FIREBASE_PROJECT=app
