includes:
    - phpstan-identity-env.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 6 is the Phase 00 floor: types, return values, and unreachable
    # code. Raising it is later work; a floor nobody can run is not a floor.
    level: 6
    paths:
        - app
        - Modules
    excludePaths:
        - app/Http/Controllers/Controller.php
    treatPhpDocTypesAsCertain: false
    # V1 ships a single Currency case (EGP). Equality checks are the
    # multi-currency invariant and become live when a second case is added.
    ignoreErrors:
        -
            identifier: identical.alwaysTrue
            path: Modules/Platform/app/Support/Money.php
        -
            identifier: notIdentical.alwaysFalse
            path: Modules/Platform/app/Support/Money.php
        -
            identifier: void.pure
            path: Modules/Platform/app/Support/Money.php
        -
            identifier: booleanNot.alwaysTrue
            path: Modules/Platform/app/Console/OutboxWorkCommand.php
