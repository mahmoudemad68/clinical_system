# CI uses setup-node Node 22 (npm 10.x). engines require npm >=10.9.
# min-release-age was added in npm 11.10 and would be silently ignored here.
# Installs are `npm ci` from the committed lockfile (ADR 0008).
# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age
ignore-scripts=true
audit=true
