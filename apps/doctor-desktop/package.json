    "@clinic/error-handling": "0.1.0",
    "@clinic/localization": "0.1.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.3.1",
    "@tanstack/react-query": "5.102.3",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
