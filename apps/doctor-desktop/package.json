{
  "name": "@clinic/doctor-desktop",
  "productName": "Clinic Doctor",
  "version": "0.1.0",
  "private": true,
  "description": "Clinic Doctor desktop application (Electron + React + TypeScript).",
  "main": ".webpack/main",
  "scripts": {
    "start": "node ../../scripts/desktop/ensure-linux-chromium-sandbox.mjs && electron-forge start",
