    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/webpack-asset-relocator-loader": "1.11.0",
    "css-loader": "7.1.4",
    "electron": "44.0.0",
    "jsdom": "30.0.1",
    "node-loader": "2.1.0",
