# ---------------------------------------------------------------------------
# Secrets and environment material. Phase 00 rule: secrets never enter git.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!**/testdata/*.key
*.p12
*.jks
*.keystore
secrets/
.secrets/

