# Local Compose overlay for Playwright/k6. Well-known placeholders only.
# Used as the Laravel .env inside the e2e container (host .env is not used).

APP_NAME="Clinic Platform"
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
APP_URL=http://127.0.0.1:8080
APP_VERSION=0.1.0-local
APP_COUNTRY=EG
APP_CURRENCY=EGP
APP_BUSINESS_TIMEZONE=Africa/Cairo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=ar,en
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinic_test
DB_USERNAME=clinic_migrator
DB_PASSWORD=local_dev_only_not_a_secret
DB_SSLMODE=prefer
DB_MIGRATION_USERNAME=clinic_migrator
DB_MIGRATION_PASSWORD=local_dev_only_not_a_secret
DB_AUDIT_USERNAME=clinic_audit_writer
DB_AUDIT_PASSWORD=local_dev_only_not_a_secret

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_REALTIME_DB=2
REDIS_RATELIMIT_DB=3

CACHE_STORE=redis
CACHE_PREFIX=clinic_cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=clinic_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

IDENTITY_ALLOW_SYNTHETIC_NATIONAL_IDS=true
IDENTITY_HMAC_VERSION=1
IDENTITY_HMAC_KEY_V1=local_dev_only_identity_hmac_v1_not_a_secret_32b
IDENTITY_ENCRYPTION_VERSION=1
IDENTITY_ENCRYPTION_KEY_V1=local_dev_only_identity_enc_v1_not_a_secret_32b
AUTH_OTP_PEPPER_VERSION=1
AUTH_OTP_PEPPER_V1=local_dev_only_otp_pepper_v1_not_a_secret_32bytes
AUTH_RATE_LIMIT_STORE=ratelimit
AUTH_RATE_LIMIT_DRIVER=redis
FEATURE_AUTH_REGISTRATION=true
FEATURE_AUTH_RECOVERY=true
TELESCOPE_ENABLED=false
TELEMETRY_REDACTION_ENABLED=true
TELEMETRY_REDACTION_STRICT=true
HASH_DRIVER=argon2id
ARGON_MEMORY=16384
ARGON_THREADS=1
ARGON_TIME=1
PENNANT_STORE=array
LOG_CHANNEL=stack
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
