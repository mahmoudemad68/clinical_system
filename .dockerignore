# Keep the build context small and free of anything that must not enter an image.
**/.git
**/.github
**/node_modules
**/vendor
**/.venv
**/venv
**/__pycache__
**/.dart_tool
**/build
**/dist
**/coverage
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.phpunit.cache
**/storage/logs/*
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*

# Never copy environment material into an image layer.
**/.env
**/.env.*
!**/.env.example
infra/environments/*.env

# Not needed at runtime.
apps/patient-app
apps/doctor-desktop
apps/pharmacy-desktop
packages/flutter
docs
plan.md
*.md
