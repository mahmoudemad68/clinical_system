root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[{composer.lock,package-lock.json,pubspec.lock}]
insert_final_newline = false
